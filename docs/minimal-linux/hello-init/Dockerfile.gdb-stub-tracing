# Hello Init - Workload Discovery: QEMU GDB Stub Syscall Tracing
#
# This Dockerfile reproduces the "Tracing a minimal user space" scenario
# from Documentation/admin-guide/workload-tracing.rst:
# - Builds a minimal tinyconfig kernel with DWARF debug info and vmlinux ELF.
# - Statically compiles the minimal 'ainit.c' PID 1 application into an initramfs.
# - Launches QEMU with '-S -gdb tcp:127.0.0.1:1234' (pausing before boot) and 'nokaslr'.
# - Connects host 'gdb-multiarch' to trap syscall entry in 'do_el0_svc'.
# - Captures syscall numbers (regs->regs[8]) and arg0 (regs->regs[0]) non-intrusively.
# - Resolves ARM64 syscall numbers (e.g. syscall 64 = write) without in-guest tooling.

ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# Install cross-compilation toolchain, QEMU emulator, gdb-multiarch, and build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    file \
    gcc-aarch64-linux-gnu \
    binutils-aarch64-linux-gnu \
    libc6-dev-arm64-cross \
    bison \
    flex \
    libssl-dev \
    libelf-dev \
    bc \
    make \
    git \
    cpio \
    qemu-system-arm \
    ipxe-qemu \
    gdb-multiarch \
    cloc \
    python3 \
    wget \
    vim \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG KERNEL_REPO=https://git.kernel.org/pub/scm/linux/kernel/git/stable/linux-stable.git
ARG KERNEL_TAG=v7.3-rc5
ARG SLOC_HELPER_URL=https://raw.githubusercontent.com/matthew-l-weber/linux/398a7781b2ddd81b8fcf809a019209a32c883c8d/scripts/kernel-sloc
ARG SLOC_HELPER_SHA256=4f83ebd27759f6bff2d696260e665849575d1b31a5940676a57140f8c94e4f40

WORKDIR /workspace

RUN wget -q -O /usr/local/bin/kernel-sloc "${SLOC_HELPER_URL}" \
    && printf "%s  %s\n" "${SLOC_HELPER_SHA256}" /usr/local/bin/kernel-sloc | sha256sum -c - \
    && chmod 0755 /usr/local/bin/kernel-sloc \
    && git config --global --add safe.directory '*'

RUN git clone --depth 1 --branch "${KERNEL_TAG}" "${KERNEL_REPO}" linux

WORKDIR /workspace/linux
RUN mkdir -p scripts && ln -sf /usr/local/bin/kernel-sloc scripts/kernel-sloc

ENV ARCH=arm64
ENV CROSS_COMPILE=aarch64-linux-gnu-

COPY docs/minimal-linux/hello-init /workspace/src

# ------------------------------------------------------------------------------
# Build Minimal User Space (ainit) & Initramfs
# ------------------------------------------------------------------------------
WORKDIR /workspace
RUN mkdir -p rootfs \
    && aarch64-linux-gnu-gcc -static -O2 -o rootfs/init /workspace/src/ainit.c \
    && ( cd rootfs && find . | cpio -o -H newc ) | gzip > initramfs.cpio.gz

# ------------------------------------------------------------------------------
# Configure & Build Minimal Kernel with DWARF Debug Info
# ------------------------------------------------------------------------------
WORKDIR /workspace/linux
RUN make tinyconfig \
    && ./scripts/config \
       -e PRINTK -e TTY -e SERIAL_AMBA_PL011 -e SERIAL_AMBA_PL011_CONSOLE \
       -e BINFMT_ELF -e BLK_DEV_INITRD -d MODULES \
       -d DEBUG_INFO_NONE \
       -e DEBUG_KERNEL -e DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT \
       -d DEBUG_INFO_BTF -d DEBUG_INFO_SPLIT \
    && make olddefconfig \
    && make -j"$(nproc)" Image vmlinux

# ------------------------------------------------------------------------------
# Execute QEMU with GDB Stub & Trap Syscalls
# ------------------------------------------------------------------------------
# 1. Launch QEMU paused (-S) with GDB server listening on port 1234
# 2. Connect gdb-multiarch, set temporary breakpoint on kernel_init, then trap do_el0_svc
WORKDIR /workspace
RUN printf '%s\n' \
    'target remote localhost:1234' \
    'tbreak kernel_init' \
    'continue' \
    'set pagination off' \
    'set logging file /workspace/pid1-syscalls.log' \
    'set logging enabled on' \
    'break do_el0_svc' \
    'commands' \
    'silent' \
    'printf "syscall=%lu arg0=%#lx\n", regs->regs[8], regs->regs[0]' \
    'continue' \
    'end' \
    'continue' \
    > /workspace/gdb-trace.cmd

RUN qemu-system-aarch64 -machine virt -cpu cortex-a57 -nographic \
        -kernel /workspace/linux/arch/arm64/boot/Image -initrd /workspace/initramfs.cpio.gz \
        -append 'console=ttyAMA0 nokaslr' -S -gdb tcp:127.0.0.1:1234 > /workspace/qemu-gdb.log 2>&1 & \
    QEMU_PID=$! \
    && sleep 2 \
    && ( timeout 15s gdb-multiarch /workspace/linux/vmlinux -x /workspace/gdb-trace.cmd --batch || true ) \
    && kill -9 $QEMU_PID 2>/dev/null || true

# Fail the build if the trace did not capture PID 1's write(1, "hello world\n", 12)
RUN if ! grep -q '^syscall=64 arg0=0x1' /workspace/pid1-syscalls.log; then \
        cat /workspace/qemu-gdb.log; exit 1; \
    fi

# ------------------------------------------------------------------------------
# Format Syscall Trace Report
# ------------------------------------------------------------------------------
RUN { \
        echo "=== Workload Discovery: QEMU GDB Stub Syscall Trace ==="; \
        echo "PID 1 Binary : ainit (minimal hello world)"; \
        echo "Tracing Hook : do_el0_svc (ARM64 EL0 SVC trap)"; \
        echo "Output Log   : /workspace/pid1-syscalls.log"; \
        echo ""; \
        echo "Captured Syscall Invocations:"; \
        cat /workspace/pid1-syscalls.log 2>/dev/null || echo "No syscalls captured"; \
    } | tee /workspace/metrics.txt

CMD ["cat", "/workspace/pid1-syscalls.log"]
